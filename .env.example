DATABASE_URL=mysql+pymysql://hub:hub@localhost:3306/hub_pessoal
API_CORS_ORIGINS=http://localhost:3000
PUBLIC_HISTORY_ENABLED=true
UTILITIES_ENABLED=false
LINK_RESOLVER_ENABLED=false
LINK_RESOLVER_MAX_REDIRECTS=8
LINK_RESOLVER_TOTAL_TIMEOUT_SECONDS=12
LINK_RESOLVER_CONNECT_TIMEOUT_SECONDS=3
LINK_RESOLVER_READ_TIMEOUT_SECONDS=3
BACKGROUND_REMOVER_ENABLED=false
MIND_GOOGLE_DRIVE_ENABLED=false
# Configure only in a private Vercel Preview after creating the Google OAuth web client.
# Keep these server-only values out of source control:
# MIND_SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REDIRECT_URI=
# MIND_GOOGLE_TOKEN_ENCRYPTION_KEY=
# MIND_GOOGLE_DRIVE_ALLOWED_ORIGINS=
# Optional: use only an existing authorized TheSportsDB key. No subscription is created.
# SPORTSDB_API_KEY=
