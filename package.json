{
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "dev": "npm run build && esbuild frontend/src/main.ts --bundle --outfile=dist/bundle.js --sourcemap --servedir=dist --serve=3000 --watch=forever --define:globalThis.__2T_API_BASE_URL__=\\\"http://localhost:8000\\\"",
    "build": "npm run typecheck && npm run build:js && npm run build:css && node -e \"require('fs').copyFileSync('frontend/index.html','dist/index.html'); require('fs').copyFileSync('frontend/public/2t-mark.svg','dist/2t-mark.svg'); require('fs').copyFileSync('frontend/public/2t-logo.webp','dist/2t-logo.webp')\"",
    "build:js": "esbuild frontend/src/main.ts --bundle --minify --outfile=dist/bundle.js && esbuild frontend/src/learn/page.ts --bundle --format=esm --minify --outfile=dist/learn.js",
    "build:css": "sass frontend/styles/main.scss dist/styles.css --style=compressed && node scripts/copy-financials.cjs"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "sass": "^1.83.4",
    "typescript": "^5.7.2"
  }
}
